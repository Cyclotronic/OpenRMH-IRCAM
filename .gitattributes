# Visual Studio tooling expects CRLF in these; everything else normalises to LF in the repo.
*                  text=auto
*.sln              text eol=crlf
*.vcxproj          text eol=crlf
*.vcxproj.filters  text eol=crlf
*.props            text eol=crlf
*.rc               text eol=crlf
*.resx             text eol=crlf
*.ps1              text eol=crlf
*.md               text eol=lf

# Binary assets
*.ico   binary
*.png   binary
*.jpg   binary
*.pdf   binary
